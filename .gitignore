# AI Agent 项目 .gitignore 模板
# 
# 将此文件复制到 ai-agent-app/.gitignore
#
# 重要: 确保不提交敏感信息到 Git！

# 依赖
node_modules/
.pnp
.pnp.js

# 测试
coverage/

# Next.js 构建输出
.next/
out/
build/
dist/
public/sw*
public/swe-worker*

# 生产环境
.vercel

# 调试
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# 环境变量 - 非常重要！
.env
.env*.local
.env.production

# Bun
.bun/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# 数据库
*.db
*.sqlite
*.sqlite3

# 日志
logs/
*.log
