  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "echo \"E2E tests should be placed in tests/e2e and run with Playwright/Cypress\"",
    "test:coverage": "vitest run --coverage",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run test:run",
    "inspect:supabase": "bun scripts/inspect-supabase.ts"
  },
